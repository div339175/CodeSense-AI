# CodeSense AI Environment Configuration Example
# Copy this file to .env and fill in your API key if you want live cloud LLM integration.
# If no key is set, CodeSense AI automatically uses its built-in Pedagogical Mock Engine!

# Google Gemini API Key (Optional for cloud LLM)
GEMINI_API_KEY=

# OpenAI API Key (Optional for cloud LLM)
OPENAI_API_KEY=

# Default Provider: auto, gemini, openai, or mock
DEFAULT_PROVIDER=auto

# Model settings
DEFAULT_MODEL=gemini-2.5-flash
FALLBACK_OPENAI_MODEL=gpt-4o-mini

# API Timeout in seconds
API_TIMEOUT_SECONDS=30
